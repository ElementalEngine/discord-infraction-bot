# Lady Justice environment. The bot loads .env.<NODE_ENV> from the repo root,
# .env.development when NODE_ENV is unset. Every id is checked at startup.
NODE_ENV=development

# core-api
BACKEND_BASE_URL=http://127.0.0.1:8001
LJ_SERVICE_TOKEN=replace-me
REQUEST_TIMEOUT_MS=10000

# Discord application
BOT_TOKEN=replace-me
DISCORD_GUILD_ID=000000000000000000

# The channel staff run the commands in, where every outcome is posted
CHANNEL_SUSPENDED_ID=000000000000000000

# Staff, and the role a suspension gives
ROLE_MODERATOR=000000000000000000
ROLE_BACKEND=000000000000000000
ROLE_SUSPENDED=000000000000000000

# Three lagger strikes give the first role and take the second
ROLE_LAGGER=000000000000000000
ROLE_HOST=000000000000000000

# The roles a suspension takes away and its end gives back
ROLE_CIV6=000000000000000000
ROLE_CIV7=000000000000000000
ROLE_CIV6_NOVICE=000000000000000000
ROLE_CPL_TOURNAMENT=000000000000000000
ROLE_CPL_CLOUD=000000000000000000
ROLE_CPL_NOVICE_MANAGER=000000000000000000
ROLE_CPL_COACH=000000000000000000
